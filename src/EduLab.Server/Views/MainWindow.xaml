<Window x:Class="EduLab.Server.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EduLab Server - Quản Lý Phòng Tin Học (40 Máy)"
        Height="900" Width="1440"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI, Arial">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header & Counter Badges -->
        <Border Grid.Row="0" Background="#1E293B" Padding="20,12" BorderBrush="#334155" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="EduLab" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,10,0"/>
                    <Border Background="#334155" CornerRadius="6" Padding="6,2" VerticalAlignment="Center" Margin="0,0,15,0">
                        <TextBlock Text="PHÒNG TIN HỌC" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                    </Border>
                    <Border Background="#0284C7" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ServerIpDisplay}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </Border>
                </StackPanel>

                <!-- Statistics Badges -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#0F172A" CornerRadius="8" Padding="12,6" Margin="0,0,8,0" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖥️ Tổng máy: " FontSize="12" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding TotalCount}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#0F172A" CornerRadius="8" Padding="12,6" Margin="0,0,8,0" BorderBrush="#166534" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🟢 Online: " FontSize="12" Foreground="#4ADE80"/>
                            <TextBlock Text="{Binding OnlineCount}" FontSize="12" FontWeight="Bold" Foreground="#4ADE80"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#0F172A" CornerRadius="8" Padding="12,6" Margin="0,0,8,0" BorderBrush="#991B1B" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔒 Đang khóa: " FontSize="12" Foreground="#F87171"/>
                            <TextBlock Text="{Binding LockedCount}" FontSize="12" FontWeight="Bold" Foreground="#F87171"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#0F172A" CornerRadius="8" Padding="12,6" BorderBrush="#075985" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💻 Đang học: " FontSize="12" Foreground="#38BDF8"/>
                            <TextBlock Text="{Binding InUseCount}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Command Toolbar (Ribbon) -->
        <Border Grid.Row="1" Background="#1E293B" Padding="15,10" BorderBrush="#334155" BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal">
                <Button Content="🔒 Khóa Tất Cả" Height="36" Padding="14,0" Margin="0,0,8,0"
                        Background="#DC2626" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                        Click="BtnLockAll_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>

                <Button Content="🔓 Mở Tất Cả" Height="36" Padding="14,0" Margin="0,0,8,0"
                        Background="#16A34A" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                        Click="BtnUnlockAll_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>

                <Separator Width="1" Height="24" Background="#475569" Margin="6,0,12,0"/>

                <Button Content="📁 Phát Đề Bài" Height="36" Padding="14,0" Margin="0,0,8,0"
                        Background="#0284C7" Foreground="#FFFFFF" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                        Click="BtnSendFile_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>

                <Button Content="📥 Thư Mục Thu Bài" Height="36" Padding="14,0" Margin="0,0,8,0"
                        Background="#334155" Foreground="#F8FAFC" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                        Click="BtnOpenSubmissions_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>

                <Button Content="📢 Gửi Thông Báo" Height="36" Padding="14,0" Margin="0,0,8,0"
                        Background="#334155" Foreground="#F8FAFC" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                        Click="BtnBroadcast_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>

                <Button Content="🖥️ Ma Trận Màn Hình (40 Máy)" Height="36" Padding="14,0" Margin="0,0,8,0"
                        Background="#4F46E5" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                        Click="BtnScreenMatrix_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>

                <Separator Width="1" Height="24" Background="#475569" Margin="6,0,12,0"/>

                <Button Content="🔌 Tắt Toàn Bộ" Height="36" Padding="14,0" Margin="0,0,8,0"
                        Background="#475569" Foreground="#FCA5A5" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                        Click="BtnShutdownAll_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>

                <Button Content="🔄 Khởi Động Lại" Height="36" Padding="14,0" Margin="0,0,8,0"
                        Background="#475569" Foreground="#F8FAFC" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                        Click="BtnRestartAll_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
            </WrapPanel>
        </Border>

        <!-- 3. Room Matrix Layout (40 Machines) -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="15">
            <ItemsControl ItemsSource="{Binding Machines}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- Grid 8 cột x 5 hàng cho 40 máy -->
                        <UniformGrid Columns="8" Rows="5"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1E293B" CornerRadius="10" Margin="6" Padding="10"
                                BorderBrush="#334155" BorderThickness="1.5">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="🔒 Khóa máy này" Click="MenuLockSingle_Click"/>
                                    <MenuItem Header="🔓 Mở khóa máy này" Click="MenuUnlockSingle_Click"/>
                                    <Separator/>
                                    <MenuItem Header="🔌 Tắt máy này" Click="MenuShutdownSingle_Click"/>
                                    <MenuItem Header="🔄 Khởi động lại" Click="MenuRestartSingle_Click"/>
                                </ContextMenu>
                            </Border.ContextMenu>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="90"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Machine Header -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="{Binding StatusColor}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{Binding StatusColor}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>

                                <!-- Mini Screen Thumbnail / Preview -->
                                <Border Grid.Row="1" Background="#0F172A" CornerRadius="6" ClipToBounds="True" Margin="0,0,0,6">
                                    <Grid>
                                        <!-- Placeholder when no image -->
                                        <TextBlock Text="Màn hình chờ..." FontSize="10" Foreground="#475569"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <!-- Real-time screen image -->
                                        <Image Source="{Binding ThumbnailSource}" Stretch="UniformToFill"/>
                                    </Grid>
                                </Border>

                                <!-- Student info & IP -->
                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="{Binding StudentName, TargetNullValue='--- Chưa điểm danh ---'}"
                                               FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding IpAddress, TargetNullValue='Offline'}"
                                               FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 4. Footer & Real-time Notification -->
        <Border Grid.Row="3" Background="#0F172A" Padding="15,8" BorderBrush="#334155" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock Text="📢" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusNotification}" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                <TextBlock Text="EduLab Server v1.0 • Phòng máy 40 trạm" FontSize="11" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
