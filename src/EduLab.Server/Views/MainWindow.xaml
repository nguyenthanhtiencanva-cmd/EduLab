<Window x:Class="EduLab.Server.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EduLab - Hệ Thống Quản Lý Phòng Máy Tin Học (40 Trạm)"
        Height="900" Width="1440"
        MinHeight="768" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI, Arial">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Main Ribbon Toolbar -->
            <RowDefinition Height="Auto"/> <!-- Filter & View Switcher -->
            <RowDefinition Height="*"/>    <!-- 40 Workstations Grid -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Header & System Badges -->
        <Border Grid.Row="0" Background="#1E293B" Padding="20,12" BorderBrush="#334155" BorderThickness="0,0,0,1">
            <DockPanel>
                <!-- Brand Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#0284C7" CornerRadius="8" Padding="10,6" Margin="0,0,12,0">
                        <TextBlock Text="EduLab" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="QUẢN LÝ PHÒNG TIN HỌC" FontSize="13" FontWeight="Bold" Foreground="#38BDF8"/>
                        <TextBlock Text="{Binding ServerIpDisplay}" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Statistics Badges -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Total -->
                    <Border Background="#0F172A" CornerRadius="8" Padding="12,6" Margin="0,0,8,0" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖥️ Tổng máy: " FontSize="12" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding TotalCount}" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </StackPanel>
                    </Border>

                    <!-- Online -->
                    <Border Background="#0F172A" CornerRadius="8" Padding="12,6" Margin="0,0,8,0" BorderBrush="#0284C7" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🟢 Đang kết nối: " FontSize="12" Foreground="#38BDF8"/>
                            <TextBlock Text="{Binding OnlineCount}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                        </StackPanel>
                    </Border>

                    <!-- Checked-in Students -->
                    <Border Background="#0F172A" CornerRadius="8" Padding="12,6" Margin="0,0,8,0" BorderBrush="#059669" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👨‍🎓 Đã báo danh: " FontSize="12" Foreground="#10B981"/>
                            <TextBlock Text="{Binding CheckedInCount}" FontSize="12" FontWeight="Bold" Foreground="#10B981"/>
                        </StackPanel>
                    </Border>

                    <!-- Locked -->
                    <Border Background="#0F172A" CornerRadius="8" Padding="12,6" BorderBrush="#DC2626" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔒 Đang khóa: " FontSize="12" Foreground="#F87171"/>
                            <TextBlock Text="{Binding LockedCount}" FontSize="12" FontWeight="Bold" Foreground="#F87171"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Refined Operations Toolbar -->
        <Border Grid.Row="1" Background="#1E293B" Padding="15,10" BorderBrush="#334155" BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Group 1: Screen Security Control -->
                <TextBlock Text="BẢO MẬT &amp; KHÓA:" FontSize="11" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>

                <Button Content="🔒 Khóa Toàn Phòng" Height="36" Padding="14,0" Margin="0,0,8,0"
                        Background="#DC2626" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                        Click="BtnLockAll_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>

                <Button Content="🔓 Mở Toàn Phòng" Height="36" Padding="14,0" Margin="0,0,14,0"
                        Background="#16A34A" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                        Click="BtnUnlockAll_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>

                <Separator Width="1" Height="26" Background="#475569" Margin="0,0,14,0" VerticalAlignment="Center"/>

                <!-- Group 2: Teaching & Classroom Management -->
                <TextBlock Text="DẠY &amp; HỌC:" FontSize="11" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>

                <Button Content="📁 Phát Đề Bài / Tài Liệu" Height="36" Padding="14,0" Margin="0,0,8,0"
                        Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                        Click="BtnSendFile_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>

                <Button Content="📥 Thư Mục Thu Bài" Height="36" Padding="14,0" Margin="0,0,8,0"
                        Background="#334155" Foreground="#F8FAFC" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                        Click="BtnOpenSubmissions_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>

                <Button Content="📢 Phát Thông Báo" Height="36" Padding="14,0" Margin="0,0,8,0"
                        Background="#334155" Foreground="#F8FAFC" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                        Click="BtnBroadcast_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>

                <Button Content="🖥️ Giám Sát Màn Hình (40 Máy)" Height="36" Padding="14,0" Margin="0,0,14,0"
                        Background="#4F46E5" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0" Cursor="Hand"
                        Click="BtnScreenMatrix_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>

                <Separator Width="1" Height="26" Background="#475569" Margin="0,0,14,0" VerticalAlignment="Center"/>

                <!-- Group 3: Power Operations -->
                <TextBlock Text="NGUỒN ĐIỆN:" FontSize="11" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>

                <Button Content="🔌 Tắt 40 Máy" Height="36" Padding="14,0" Margin="0,0,8,0"
                        Background="#475569" Foreground="#FCA5A5" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                        Click="BtnShutdownAll_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>

                <Button Content="🔄 Khởi Động Lại" Height="36" Padding="14,0" Margin="0,0,0,0"
                        Background="#475569" Foreground="#F8FAFC" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                        Click="BtnRestartAll_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
            </WrapPanel>
        </Border>

        <!-- 3. Filter Bar for Quick Navigation -->
        <Border Grid.Row="2" Background="#0F172A" Padding="20,8" BorderBrush="#334155" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Bộ lọc hiển thị: " FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <RadioButton Content="Tất cả (40 máy)" IsChecked="True" GroupName="FilterGroup"
                                 Foreground="#F8FAFC" Margin="0,0,15,0" VerticalAlignment="Center"
                                 Click="FilterAll_Click"/>
                    <RadioButton Content="🟢 Đang kết nối" GroupName="FilterGroup"
                                 Foreground="#38BDF8" Margin="0,0,15,0" VerticalAlignment="Center"
                                 Click="FilterOnline_Click"/>
                    <RadioButton Content="👨‍🎓 Có học sinh báo danh" GroupName="FilterGroup"
                                 Foreground="#10B981" Margin="0,0,15,0" VerticalAlignment="Center"
                                 Click="FilterInUse_Click"/>
                    <RadioButton Content="🔒 Đang khóa" GroupName="FilterGroup"
                                 Foreground="#F87171" Margin="0,0,15,0" VerticalAlignment="Center"
                                 Click="FilterLocked_Click"/>
                    <RadioButton Content="⚫ Chưa bật (Offline)" GroupName="FilterGroup"
                                 Foreground="#94A3B8" Margin="0,0,15,0" VerticalAlignment="Center"
                                 Click="FilterOffline_Click"/>
                </StackPanel>

                <TextBlock Text="💡 Mẹo: Nhấp đúp vào máy bất kỳ để xem màn hình trực tiếp hoặc chuột phải để thao tác riêng"
                           FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- 4. Workstations Matrix (40 Machines Layout) -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="15">
            <ItemsControl ItemsSource="{Binding Machines}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- Grid 8 cột x 5 hàng cho 40 máy chuẩn phòng tin học -->
                        <UniformGrid Columns="8" Rows="5"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Workstation Card -->
                        <Border Background="#1E293B" CornerRadius="10" Margin="5" Padding="8"
                                BorderBrush="{Binding CardBorderBrush}" BorderThickness="1.5"
                                MouseLeftButtonDown="MachineCard_MouseLeftButtonDown">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="🔒 Khóa máy này" Click="MenuLockSingle_Click"/>
                                    <MenuItem Header="🔓 Mở khóa máy này" Click="MenuUnlockSingle_Click"/>
                                    <Separator/>
                                    <MenuItem Header="🔌 Tắt nguồn máy này" Click="MenuShutdownSingle_Click"/>
                                    <MenuItem Header="🔄 Khởi động lại máy này" Click="MenuRestartSingle_Click"/>
                                </ContextMenu>
                            </Border.ContextMenu>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Header: Name + Badge -->
                                    <RowDefinition Height="85"/>   <!-- Screen Preview -->
                                    <RowDefinition Height="Auto"/> <!-- Student info + IP -->
                                    <RowDefinition Height="Auto"/> <!-- Quick Action Buttons -->
                                </Grid.RowDefinitions>

                                <!-- Header: Machine Name & Status Badge -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,5">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                    <Border Background="{Binding StatusBadgeBg}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="Bold" Foreground="{Binding StatusColor}"/>
                                    </Border>
                                </DockPanel>

                                <!-- Screen Preview Thumbnail -->
                                <Border Grid.Row="1" Background="#090D16" CornerRadius="6" ClipToBounds="True" Margin="0,0,0,5">
                                    <Grid>
                                        <TextBlock Text="Màn hình chờ..." FontSize="10" Foreground="#475569"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding ThumbnailSource}" Stretch="UniformToFill"/>
                                    </Grid>
                                </Border>

                                <!-- Student Name & IP Address -->
                                <StackPanel Grid.Row="2" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding StudentDisplayInfo}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding HasStudent, Converter={x:Null}}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding IpAddress, TargetNullValue='Offline'}"
                                               FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Quick Control Buttons (1-Click Actions) -->
                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Quick Lock / Unlock Toggle Button -->
                                    <Button Grid.Column="0" Height="24" FontSize="10" FontWeight="Bold"
                                            Background="#334155" Foreground="#F8FAFC" BorderThickness="0" Cursor="Hand"
                                            Click="BtnQuickToggleLock_Click">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Content" Value="Mở máy"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLocked}" Value="false">
                                                        <Setter Property="Content" Value="Khóa"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <!-- Quick Power Menu -->
                                    <Button Grid.Column="2" Content="Tắt" Height="24" FontSize="10"
                                            Background="#334155" Foreground="#FCA5A5" BorderThickness="0" Cursor="Hand"
                                            Click="BtnQuickShutdown_Click">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 5. Real-time Status Footer -->
        <Border Grid.Row="4" Background="#0F172A" Padding="15,8" BorderBrush="#334155" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock Text="⚡" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusNotification}" FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="EduLab v2.0 • Bản tối ưu phòng 40 máy Wi-Fi" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>