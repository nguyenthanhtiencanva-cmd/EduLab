<Window x:Class="EduLab.Server.Views.ScreenMatrixWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EduLab - Giám Sát Trực Tiếp 40 Màn Hình Học Sinh"
        Height="880" Width="1440"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#0B0F19"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI, Arial">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Ribbon -->
        <Border Grid.Row="0" Background="#111827" Padding="20,12" BorderBrush="#1F2937" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🖥️ GIÁM SÁT TRỰC TIẾP 40 MÀN HÌNH"
                               FontSize="16" FontWeight="Bold" Foreground="#38BDF8"/>
                    <TextBlock Text=" • Nhấp đúp vào bất kỳ màn hình nào để phóng to toàn màn hình"
                               FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <Button Content="Đóng cửa sổ (ESC)" Height="32" Padding="16,0"
                        Background="#374151" Foreground="#FFFFFF" FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" Click="BtnClose_Click">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
            </DockPanel>
        </Border>

        <!-- 40 Screens Uniform Matrix -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10">
            <ItemsControl ItemsSource="{Binding AllMachines}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="8" Rows="5"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1F2937" CornerRadius="8" Margin="4" Padding="6"
                                BorderBrush="{Binding CardBorderBrush}" BorderThickness="1.5"
                                Cursor="Hand" MouseLeftButtonDown="ScreenItem_MouseLeftButtonDown">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Title info -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                                    <TextBlock Text="{Binding StudentDisplayInfo}"
                                               FontSize="10" Foreground="#38BDF8" HorizontalAlignment="Right"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>

                                <!-- Screen Preview -->
                                <Border Grid.Row="1" Background="#030712" CornerRadius="4" ClipToBounds="True" MinHeight="90">
                                    <Grid>
                                        <TextBlock Text="Màn hình chờ..." FontSize="10" Foreground="#4B5563"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding ThumbnailSource}" Stretch="UniformToFill"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>