<Window x:Class="EduLab.Client.Views.LockScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EduLab Client - Khóa Màn Hình"
        WindowStyle="None"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI, Arial"
        ResizeMode="NoResize">
    
    <Grid>
        <!-- Background subtle glow decoration -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Width="800" Height="500" CornerRadius="20"
                Background="#1E293B" Padding="40"
                BorderBrush="#334155" BorderThickness="1.5">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="10" Opacity="0.6"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,15">
                    <TextBlock Text="HỆ THỐNG QUẢN LÝ PHÒNG TIN HỌC"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="#38BDF8" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtMachineName" Text="MÁY TRẠM"
                               FontSize="32" FontWeight="Bold"
                               Foreground="#FFFFFF" HorizontalAlignment="Center"
                               Margin="0,5,0,5"/>
                    <Border Background="#EF4444" CornerRadius="12" Padding="12,4" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtLockStatus" Text="MÀN HÌNH ĐANG KHÓA"
                                   FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </Border>
                </StackPanel>

                <!-- Notice -->
                <TextBlock Grid.Row="1" Text="Vui lòng nhập thông tin học sinh để điểm danh hoặc chờ thầy cô mở khóa máy."
                           FontSize="13" Foreground="#94A3B8"
                           HorizontalAlignment="Center" Margin="0,0,0,25" TextWrapping="Wrap"/>

                <!-- Check-in Form -->
                <StackPanel Grid.Row="2" Width="400" HorizontalAlignment="Center">
                    <TextBlock Text="Họ và tên học sinh:" FontSize="13" Foreground="#CBD5E1" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtStudentName" Height="38" FontSize="14"
                             Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#475569"
                             Padding="10,8" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Mã số học sinh:" FontSize="13" Foreground="#CBD5E1" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtStudentId" Height="38" FontSize="14"
                                     Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#475569"
                                     Padding="10,8" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Lớp:" FontSize="13" Foreground="#CBD5E1" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtClassName" Height="38" FontSize="14"
                                     Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#475569"
                                     Padding="10,8" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Button x:Name="BtnCheckIn" Content="Báo Danh Vào Tiết Học" Height="42"
                            Background="#0284C7" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"
                            BorderThickness="0" Cursor="Hand" Click="BtnCheckIn_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <!-- Footer status -->
                <DockPanel Grid.Row="3" Margin="0,20,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtNetworkStatus" Text="Trạng thái mạng: Đang kết nối..."
                                   FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                        <Button Content="⚙️ Cài đặt IP" FontSize="11" Foreground="#38BDF8"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Margin="12,0,0,0" VerticalAlignment="Center" Click="BtnConfigIp_Click"/>
                    </StackPanel>
                    <TextBlock Text="EduLab v1.0 • Windows 11"
                               FontSize="12" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
