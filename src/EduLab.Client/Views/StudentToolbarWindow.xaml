<Window x:Class="EduLab.Client.Views.StudentToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thanh Công Cụ Học Sinh"
        Height="54" Width="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    
    <Border Background="#1E293BF0"
            CornerRadius="12"
            BorderBrush="#0284C7"
            BorderThickness="1.5"
            Padding="14,6">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.5"/>
        </Border.Effect>

        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Student Name Badge -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" Margin="0,0,8,0"/>
                <TextBlock x:Name="TxtStudentBadge" Text="Học sinh: Đang học"
                           FontSize="12" FontWeight="Bold" Foreground="#F8FAFC"/>
            </StackPanel>

            <!-- Status hint -->
            <TextBlock Grid.Column="1" x:Name="TxtStatus" Text="Kéo file bài tập thả vào đây để nộp"
                       FontSize="11" Foreground="#94A3B8"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

            <!-- Action buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnSubmitFile" Content="📥 Nộp Bài Tập"
                        Height="34" Padding="14,0"
                        Background="#0284C7" Foreground="#FFFFFF"
                        FontSize="12" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand" Click="BtnSubmitFile_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>